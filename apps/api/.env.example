# Copy to apps/api/.env and fill in. Never commit the real .env.
JWT_SECRET=change-me-generate-a-long-random-string
DATABASE_PATH=./oncare.db
PORT=3000

# Server-only RFID station bindings. Use HTTPS except for loopback development.
# The API polls each read-only /api/ledger endpoint once per minute. Never expose
# these bearer tokens to browsers or models.
ONCARE_RFID_STATIONS=[{"stationId":"11111111-1111-4111-8111-111111111111","facilityId":"facility_demo","baseUrl":"https://rfid.local","token":"replace_me"}]

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Optional server-side resident assistant provider. Leave OPENAI_API_KEY empty
# for the deterministic fake text adapter used by local demos.
OPENAI_API_KEY=
ONCARE_REALTIME_MODEL=gpt-realtime
ONCARE_REALTIME_ENDPOINT=https://api.openai.com/v1/realtime/calls
# Optional bounded JSON profile; an invalid configured file fails closed at startup.
ONCARE_ASSISTANT_PROFILE=
