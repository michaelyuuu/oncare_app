{
  "$ref": "#/definitions/GatewayUp",
  "definitions": {
    "GatewayUp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heartbeat"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "robotReady": {
              "type": "boolean"
            },
            "adapter": {
              "type": "string",
              "enum": [
                "navweb",
                "mock"
              ]
            },
            "pose": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "yaw": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "yaw"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "navState": {
              "type": "string"
            },
            "estop": {
              "type": "boolean"
            },
            "lift": {
              "type": "string"
            },
            "battery": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            },
            "activeCorrelationId": {
              "type": [
                "string",
                "null"
              ]
            },
            "gatewayVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "at",
            "robotReady",
            "adapter",
            "pose",
            "navState",
            "estop",
            "lift",
            "battery",
            "activeCorrelationId",
            "gatewayVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ack"
            },
            "correlationId": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "accepted",
                "expired",
                "busy",
                "duplicate",
                "rejected"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "correlationId",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "state_event"
            },
            "correlationId": {
              "$ref": "#/definitions/GatewayUp/anyOf/1/properties/correlationId"
            },
            "at": {
              "$ref": "#/definitions/GatewayUp/anyOf/0/properties/at"
            },
            "event": {
              "type": "string",
              "enum": [
                "robot_en_route",
                "arrived",
                "arrived_pickup",
                "arrived_delivery",
                "completed_leg",
                "navigation_failed",
                "cancelled",
                "safety_stopped",
                "expired"
              ]
            },
            "detail": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "type",
            "correlationId",
            "at",
            "event"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
